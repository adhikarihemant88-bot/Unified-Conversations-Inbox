# Copy to .env.local and replace every placeholder. Never commit real values.
DATABASE_URL=postgresql://inbox:inbox@localhost:5432/inbox
# Use distinct random values, e.g. `openssl rand -hex 32`.
INBOX_TOKEN=change-me
WEBHOOK_TOKEN=change-me
ADMIN_TOKEN=change-me
# Optional location-scoped agent tokens: comma-separated `location:token` pairs.
# Each token can only access its own location (REST and SSE).
# INBOX_LOCATION_TOKENS=loc_1:change-me,loc_2:change-me
PORT=3000
WORKER_ENABLED=true
MOCK_FAILURE_RATE=0.2
RETRY_BASE_MS=1000
